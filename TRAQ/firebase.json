{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": [
    {
      "target": "main",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "admin.html",
        "beta.html"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        },
        {
          "source": "/apply.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        }
      ],
      "rewrites": [
        { "source": "/bonfire", "destination": "/apply.html" },
        { "source": "/bonfire/**", "destination": "/apply.html" },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "beta",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "index.html",
        "admin.html"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        },
        {
          "source": "/beta.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        },
        {
          "source": "/apply.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        }
      ],
      "rewrites": [
        { "source": "/bonfire", "destination": "/apply.html" },
        { "source": "/bonfire/**", "destination": "/apply.html" },
        { "source": "**", "destination": "/beta.html" }
      ]
    },
    {
      "target": "admin",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "index.html",
        "apply.html"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        },
        {
          "source": "/admin.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/admin.html" }
      ]
    },
    {
      "target": "apply",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "index.html",
        "admin.html"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        },
        {
          "source": "/apply.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/apply.html" }
      ]
    },
    {
      "target": "bonfireapplications",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "index.html",
        "admin.html"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        },
        {
          "source": "/apply.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" }
          ]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/apply.html" }
      ]
    }
  ]
}
